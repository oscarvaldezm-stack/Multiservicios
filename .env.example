# Copia este archivo a .env y NUNCA lo subas a git.
ENVIRONMENT=development

# Usuario de BD con privilegios mínimos (no uses 'postgres').
DATABASE_URL=postgresql+psycopg://multiservicios_app:CAMBIA_ESTA_PASSWORD@localhost:5432/multiservicios

# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=GENERA_UNO_NUEVO_CON_EL_COMANDO_DE_ARRIBA
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

BCRYPT_ROUNDS=12
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Formato JSON para listas
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# --- KYC: cifrado de datos de identidad ---------------------------------------
# Tres secretos DISTINTOS: JWT, llave maestra y llave de índice ciego (la app no arranca si se repiten).
# Genera cada llave con:
#   python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# En producción la llave maestra vive en un KMS, no en este archivo.
KYC_MASTER_KEY=GENERA_UNA_LLAVE_DE_32_BYTES
KYC_MASTER_KEY_ID=1
# Tras rotar la llave maestra, las anteriores van aquí para poder descifrar lo viejo: "1:<b64>,2:<b64>"
# KYC_PREVIOUS_MASTER_KEYS=
KYC_BLIND_INDEX_KEY=GENERA_OTRA_LLAVE_DISTINTA_DE_32_BYTES

KYC_REVIEW_CLAIM_TIMEOUT_HOURS=48
KYC_ADDRESS_PROOF_MAX_AGE_DAYS=90
KYC_REVALIDATION_MONTHS=24

# --- KYC: documentos (Fase 3) ---------------------------------------------------
# local = solo desarrollo (directorio fuera de lo que sirve la API). Producción: s3 + KMS (obligatorio).
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./var/storage
KYC_QUARANTINE_BUCKET=kyc-quarantine
KYC_CLEAN_BUCKET=kyc-clean
S3_REGION=mx-central-1
# S3_ENDPOINT_URL=              # solo para MinIO / pruebas
# S3_KMS_KEY_ID=arn:aws:kms:mx-central-1:<cuenta>:key/<id>
# Antivirus: clamd en producción (obligatorio). dev_eicar solo detecta la firma de prueba EICAR.
KYC_SCANNER=dev_eicar
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
KYC_MAX_FILE_BYTES=10485760
KYC_MAX_IMAGE_PIXELS=40000000
KYC_MAX_PDF_PAGES=5
KYC_MAX_UPLOADS_PER_DAY=30
KYC_MAX_SCAN_ATTEMPTS=8
KYC_FILE_VIEWS_PER_HOUR=300
KYC_VIEW_TICKET_TTL_SECONDS=60

# --- Integridad de reseñas y señales antifraude (Fase 4) ---------------------------
# Cuarto secreto DISTINTO (32 bytes base64url): firma cada reseña y seudonimiza IP/dispositivo.
INTEGRITY_KEY=GENERA_UNA_CUARTA_LLAVE_DISTINTA_DE_32_BYTES

# --- KYC: decisiones ----------------------------------------------------------------
KYC_MAX_ACTIVE_CLAIMS=10

# --- Órdenes ------------------------------------------------------------------------
ORDER_AUTO_APPROVE_HOURS=72
ORDER_REQUEST_EXPIRY_HOURS=72
ORDER_DISPUTE_WINDOW_DAYS=7
ORDER_MAX_OPEN_PER_CLIENT=5

# --- Pagos (Fase 1) -------------------------------------------------------------------
# Tasas en puntos base (1600 = 16 %). Precio acordado SIN IVA. Validar retenciones con el contador.
PAYMENT_PROVIDER=stripe
PAYMENT_CURRENCY=MXN
TAX_IVA_BP=1600
WITHHOLDING_ISR_BP=250
WITHHOLDING_IVA_BP=800
WITHHOLDING_ISR_NO_RFC_BP=2000
WITHHOLDING_IVA_NO_RFC_BP=1600
# Costo estimado de Stripe (tarjeta nacional): 3.6 % + $3 + IVA. Verificar la tarifa vigente.
PROVIDER_FEE_RATE_BP=360
PROVIDER_FEE_FIXED_CENTS=300
PAYMENT_MIN_SERVICE_CENTS=5000
PAYMENT_MAX_SERVICE_CENTS=50000000
PAYMENT_AUTHORIZATION_VALID_HOURS=114

# --- Pagos (Fase 2: Stripe) --------------------------------------------------------------
# fake = proveedor en memoria (solo desarrollo). Para probar con tu cuenta de Stripe en modo prueba: stripe.
PAYMENT_PROVIDER_BACKEND=fake
# Claves de MODO PRUEBA (Dashboard > Developers > API keys). Mejor una clave restringida rk_test_.
# Fuera de producción la app rechaza claves live; en producción rechaza las de prueba.
# STRIPE_SECRET_KEY=rk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# Un secreto distinto por endpoint de webhook (Fase 4):
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
STRIPE_API_VERSION=2026-08-26.dahlia
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/pagos/cuenta/listo
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/pagos/cuenta/reintentar

# --- Pagos (Fase 4: webhooks y conciliación) ------------------------------------------------
WEBHOOK_MAX_BODY_BYTES=524288
WEBHOOK_MAX_ATTEMPTS=8
RECONCILIATION_WINDOW_HOURS=48
RECONCILIATION_INTERVAL_HOURS=24

# --- Pagos (Fase 5) ---------------------------------------------------------------------
# D8: reembolsos arriba de este monto (centavos) requieren segunda firma de FINANCE_ADMIN ($2,000 MXN).
REFUND_DOUBLE_APPROVAL_CENTS=200000

# --- Pagos (Fase 6: panel de finanzas) --------------------------------------------------------
REPORT_TIMEZONE=America/Mexico_City
RATE_PAYMENT_METHOD_PER_MINUTE=10
RATE_REFUND_REQUESTS_PER_HOUR=5

# --- Calificaciones -----------------------------------------------------------------
REVIEW_WINDOW_DAYS=30
REVIEW_EDIT_HOURS=24
REVIEW_MAX_EDITS=3
REVIEW_MAX_PER_DAY=10
REVIEW_REPORTS_PER_DAY=20
REVIEW_AUTO_HIDE_REPORTS=3
REVIEW_REPORTER_MIN_AGE_DAYS=7
REVIEW_REPLIES_ENABLED=true
REVIEW_REQUIRE_VERIFIED_EMAIL=true
REVIEW_MIN_ORDER_AMOUNT=150
REPUTATION_PRIOR_MEAN=4.0
REPUTATION_PRIOR_WEIGHT=5
REPUTATION_HALF_LIFE_DAYS=365
